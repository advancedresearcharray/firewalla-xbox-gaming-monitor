  "scoring": {
    "pingSamples": 3,
    "pingTieBreakMs": 3,
    "hopWeightMs": 0.8,
    "lossPenaltyMs": 8,
    "timeoutPenaltyMs": 12,
    "bottleneckWeightMs": 1.2
  },
  "enforcement": {
    "slowPathDeltaMs": 5,
    "slowRegionDeltaMs": 35,
    "enabledByDefault": true,
    "scope": "xbox-only",
    "note": "Blocks slow alternate destination IPs in FORWARD for Xbox source only — other LAN devices use default router paths"
  }
