      "purpose": "Call of Duty / Warzone online services backbone"
    },
    {
      "id": "warzone-playfab",
      "game": "warzone",
      "label": "Warzone — PlayFab",
      "hostname": "playfab.com",
      "purpose": "Warzone lobby, matchmaking, and session API"
    },
    {
      "id": "warzone-cod",
      "game": "warzone",
      "label": "Warzone — Call of Duty",
      "hostname": "callofduty.com",
      "purpose": "Warzone platform and title services"
    },
    {
      "id": "destiny2-stats",
      "game": "destiny2",
      "label": "Destiny 2 — stats API",
      "hostname": "stats.bungie.net",
      "purpose": "Destiny 2 live services and stats API"
    },
    {
      "id": "destiny2-platform",
