[Unit]
Description=Xbox traffic monitor (Firewalla-backed dashboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/xbox-traffic-monitor
EnvironmentFile=-/etc/default/xbox-traffic-monitor
ExecStart=/usr/bin/node /opt/xbox-traffic-monitor/server.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
