# Dashboard environment — copy to /etc/default/xbox-traffic-monitor
PORT=9377
POLL_MS=2500
FIREWALLA_HOST=192.168.1.1
FIREWALLA_USER=pi
FIREWALLA_SSH_KEY=/root/.ssh/firewalla-gaming-monitor
REMOTE_SCRIPT=/home/pi/gaming-tools/gaming-snapshot.sh
REMOTE_QOS=/home/pi/gaming-tools/gaming-role-qos.sh
REMOTE_ROUTE=/home/pi/gaming-tools/gaming-route-probe.sh
REMOTE_ENFORCE=/home/pi/gaming-tools/gaming-route-enforce.sh
XBOX_IP=192.168.1.100

# Optional AI advisor (dashboard host only — not sent to Firewalla)
# AI_ENABLED=true
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
